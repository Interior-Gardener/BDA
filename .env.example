# Copy this file to `.env` and adjust if needed.

# MongoDB connection (local default install)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=shopsense

# Dataset size for the synthetic generator: small | medium | large
DATA_SCALE=medium

# Spark
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=3g

# Save intermediate Parquet files (data lake). auto = on for Linux/macOS,
# off for Windows unless HADOOP_HOME (winutils) is configured.
SAVE_PARQUET=auto

# Web dashboard
API_HOST=127.0.0.1
API_PORT=8000
